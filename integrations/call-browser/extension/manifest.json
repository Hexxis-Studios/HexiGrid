{
  "manifest_version": 3,
  "name": "HexiGrid Call Chat",
  "version": "0.1.0",
  "description": "Connect a conversation you choose to your HexiGrid calls.",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "nativeMessaging"],
  "optional_host_permissions": ["https://muse.ai/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Connect a call chat" }
}
